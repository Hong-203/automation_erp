# ============================================================
# config-staging.properties.example
# Sao chép file này thành config-staging.properties và điền giá trị thật
# ============================================================

base.url=https://staging-app-url.com
api.base.url=https://staging-app-url.com/api/v1

execution.type=API

# Health check mock flags
api.mock=false
ui.mock=false
api.log.all=true

# Browser config
browser=chrome
headless=true
timeout.seconds=15

# Tài khoản admin
admin.username=staging_admin@erb.vn
admin.password=StagingSecure123!

# Default Entity IDs (Master Data trên môi trường Staging)
default.warehouse.id=1
default.supplier.id=1
default.product.id=3

# Bật/tắt tự động chụp ảnh màn hình khi UI test thất bại
ui.screenshot.on.failure=true

# Cấu hình Remote WebDriver chạy song song/phân tán (Mặc định tắt)
remote.web.driver=false
selenium.grid.url=http://localhost:4444/wd/hub
browserstack.username=YOUR_BROWSERSTACK_USERNAME
browserstack.key=YOUR_BROWSERSTACK_ACCESS_KEY

# Bật/tắt chạy các test case Demo (DataDrivenTest / AssertJ Demo)
run.demo.tests=false
